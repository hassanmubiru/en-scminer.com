# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL=postgresql://scminer:password@localhost:5432/scminer

# Security — generate strong random values for production
JWT_SECRET=change-me-minimum-32-chars-random-secret
SESSION_KEY=change-me-session-signing-key
JWT_EXPIRES_IN=15m
REFRESH_EXPIRES_IN=30d

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Uploads
UPLOADS_DIR=./uploads

# Email (SMTP)
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@scminer.shop
FROM_NAME=SCminer

# Crypto rates (CoinGecko)
CRYPTO_RATE_PROVIDER=coingecko
COINGECKO_API_KEY=

# Blockchain RPC endpoints
BTC_RPC_URL=
ETH_RPC_URL=https://mainnet.infura.io/v3/YOUR_KEY
TRON_API_URL=https://api.trongrid.io

# Payment expiry
CRYPTO_PAYMENT_EXPIRY_MINUTES=30

# Pagination
DEFAULT_PAGE_SIZE=12
MAX_PAGE_SIZE=100

# Free shipping threshold (USD cents)
FREE_SHIPPING_THRESHOLD_CENTS=1000000
