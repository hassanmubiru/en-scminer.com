# ── Production environment variables for the StreetJS API ──────────────────
# Set ALL of these in Railway → your service → Variables tab.
# NEVER commit real values — this file is a reference template only.

PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# ── Database ────────────────────────────────────────────────────────────────
# Railway auto-sets this when you add a PostgreSQL service.
# Copy the "DATABASE_URL" value from Railway's PostgreSQL service.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME

# ── Security — generate with: openssl rand -base64 48 ───────────────────────
JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_64_CHAR_SECRET
SESSION_KEY=REPLACE_WITH_STRONG_RANDOM_48_CHAR_SECRET

# ── CORS — your Vercel frontend URL ─────────────────────────────────────────
# Example: https://scminer.vercel.app
# Add your custom domain here too if you have one: https://scminer.com
CORS_ORIGINS=https://your-project.vercel.app

# ── Crypto rate provider ─────────────────────────────────────────────────────
COINGECKO_API_KEY=

# ── Blockchain RPC endpoints ─────────────────────────────────────────────────
BTC_RPC_URL=
ETH_RPC_URL=https://mainnet.infura.io/v3/YOUR_INFURA_KEY
TRON_API_URL=https://api.trongrid.io

# ── Payment settings ─────────────────────────────────────────────────────────
CRYPTO_PAYMENT_EXPIRY_MINUTES=30

# ── HD wallet (for crypto payment address derivation) ────────────────────────
# Generate with: https://iancoleman.io/bip39/ — use xpub ONLY, never xprv
HD_WALLET_XPUB=
